    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "{{PYTHON}} {{HOOK}} PreToolUse", "commandWindows": "& {{PYTHON}} {{HOOK}} PreToolUse", "timeout": 30}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "{{PYTHON}} {{HOOK}} Stop", "commandWindows": "& {{PYTHON}} {{HOOK}} Stop", "timeout": 30}]}]
  }
}
