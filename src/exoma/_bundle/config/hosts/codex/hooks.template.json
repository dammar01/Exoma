{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "{{PYTHON}} {{HOOK}} SessionStart", "commandWindows": "& {{PYTHON}} {{HOOK}} SessionStart", "timeout": 30}]}],
