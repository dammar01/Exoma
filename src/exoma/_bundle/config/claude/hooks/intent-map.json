{
  "_comment": "NL-map for the Pre-flight enforcement gate. KEEP IN SYNC with the Command registry NL-map in ~/.claude/CLAUDE.md. Only DELEGATED commands are listed. prefix_regex (and the slash-command payload) arms the gate; patterns are case-insensitive regex fragments matched against the user's own text (pasted content and reminders removed) and only produce an [INTENT HINT], never a block.",
  "delegated": ["explore", "plan", "analyze", "verify-browser", "verify"],
  "prefix_regex": "^\\s*/\\.(explore|plan|analyze|verify-browser|verify)(?![\\w-])",
  "patterns": {
    "explore": [
      "eksplorasi", "cari tau", "cari di ?mana", "kode mana", "di ?mana letak",
      "file apa yang", "petakan", "gimana alur", "gimana flow", "struktur.{0,12}gimana",
      "tunjukkan", "ada di ?mana", "siapa yang manggil", "apa aja yang pakai"
    ],
    "analyze": [
      "cek logic", "kenapa begini", "kenapa bisa", "analisa", "analisis", "apakah stabil",
      "ada masalah", "aman gak kalau", "dampaknya apa kalau", "bener gak desain",
      "kenapa lambat", "audit", "telusuri sebab"
    ],
    "plan": [
      "rencana", "mau bikin", "tambah fitur", "gimana caranya bikin", "susun langkah",
      "rancang", "mau ubah jadi", "butuh fitur"
    ],
    "verify-browser": [
      "test di browser", "cek di browser", "uji ui", "playwright", "e2e browser",
      "coba klik di browser", "tes alur login di browser"
    ],
    "verify": [
      "cek hasil", "bener gak", "test dong", "sudah jalan belum", "udah bener",
      "pastikan", "validasi", "cek lagi"
    ]
  }
}
