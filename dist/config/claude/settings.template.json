{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_BASH}} \"{{HOME}}/.claude/hooks/session-bind.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_BASH}} \"{{HOME}}/.claude/hooks/graph-refresh.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_BASH}} \"{{HOME}}/.claude/hooks/task-events.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_BASH}} \"{{HOME}}/.claude/hooks/status-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_BASH}} \"{{HOME}}/.claude/hooks/intent-gate-set.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_BASH}} \"{{HOME}}/.claude/hooks/task-events.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*|Read|Grep|Glob|Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_BASH}} \"{{HOME}}/.claude/hooks/intent-gate-check.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_BASH}} \"{{HOME}}/.claude/hooks/execution-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_BASH}} \"{{HOME}}/.claude/hooks/task-events.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{HOOK_BASH}} \"{{HOME}}/.claude/hooks/workflow-statusline.sh\""
  }
}
